{
	"name": "stellaris-yaml-syntax-highlighting",
	"displayName": "Stellaris Syntax Highligting for YAML/YML",
	"description": "Adds support for syntax highlighting when using Stellaris localisation files (YML/YAML).",
	"icon": "images/extensionlogo.jpg",
	"publisher": "isaacweihs",
	"version": "1.0.3",
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Programming Languages",
		"Themes"
	],
	"keywords": [
		"stellaris",
		"yaml",
		"yml",
		"modding",
		"paradox"
	],
	"contributes": {
		"languages": [
			{
				"id": "stellaris-yaml",
				"aliases": [
					"Stellaris YAML"
				],
				"filenamePatterns": [
					"*_l_*.yml"
				]
			}
		],
		"grammars": [
			{
				"path": "./syntaxes/stellaris_yaml.tmLanguage.json",
				"scopeName": "source.stellaris-yaml",
				"language": "stellaris-yaml"
			},
			{
				"path": "./syntaxes/stellaris_yaml_injection.json",
				"scopeName": "stellaris.yaml.injection",
				"injectTo": [ "source.yaml", "source.stellaris-yaml" ]
			}
		],
		"themes": [
			{
				"id": "isaacweihs.stellaris_locs.dark_default",
				"label": "Dark Default (Stellaris Localization)",
				"path": "themes/dark_default.json",
				"uiTheme": "vs-dark"
			},
						{
				"id": "isaacweihs.stellaris_locs.dark_mild",
				"label": "Dark Mild (Stellaris Localization)",
				"path": "themes/dark_mild.json",
				"uiTheme": "vs-dark"
			},
						{
				"id": "isaacweihs.stellaris_locs.dark_monotone",
				"label": "Dark Monotone (Stellaris Localization)",
				"path": "themes/dark_monotone.json",
				"uiTheme": "vs-dark"
			},
						{
				"id": "isaacweihs.stellaris_locs.dark_polychrome",
				"label": "Dark Polychrome (Stellaris Localization)",
				"path": "themes/dark_polychrome.json",
				"uiTheme": "vs-dark"
			},
						{
				"id": "isaacweihs.stellaris_locs.high_contrast",
				"label": "High Contrast (Stellaris Localization)",
				"path": "themes/hc_default.json",
				"uiTheme": "hc-black"
			},
						{
				"id": "isaacweihs.stellaris_locs.light_default",
				"label": "Light Default (Stellaris Localization)",
				"path": "themes/light_default.json",
				"uiTheme": "vs"
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "https://example.com/"
	},
	"__metadata": {
		"installedTimestamp": 1757594691738,
		"targetPlatform": "undefined",
		"size": 3008900
	}
}